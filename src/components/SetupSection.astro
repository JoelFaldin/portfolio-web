---
import SectionLabel from "./SectionLabel.astro";

const arch = String.raw`
      /\\
     /  \\
    /    \\
   /      \\
  /   ''   \\
 /   |  |   \\
/_-''    ''-_\\
`;

const info = [
    { label: "OS", value: "Arch Linux" },
    { label: "WM", value: "Hyprland" },
    { label: "Editor", value: "VSCode / Zed Editor" },
    { label: "Languages", value: "Typescript, Go, Java" },
    { label: "Focus", value: "web + systems, always learning" },
];
---

<section id="setup" class="border-t border-border/60 py-24">
    <div class="container mx-auto px-4">
        <SectionLabel section="fastfetch" title="My Setup" />

        <p
            class="mt-4 max-w-2xl text-pretty leading-relaxed text-muted-foreground"
        >
            The tools I use to build interfaces, serves and systems.
        </p>

        <div
            class="mt-12 overflow-hidden rounded-lg border border-border bg-card shadow-2xl shadow-black/40"
        >
            <div
                class="flex items-center gap-2 border-b border-border bg-secondary/60 px-4 py-2.5"
            >
                <span class="h-3 w-3 rounded-full bg-destructive/70"></span>
                <span class="h-3 w-3 rounded-full bg-muted-foreground/70"
                ></span>
                <span class="h-3 w-3 rounded-full bg-primary/70"></span>
                <span class="ml-3 font-mono text-xs text-muted-foreground"
                    >$ fastfetch</span
                >
            </div>

            <div
                class="flex flex-col gap-8 p-6 font-mono text-sm bg-card md:flex-row md:p-8"
            >
                <pre
                    class="shrink-0 leading-tight text-primary mx-20">
                {arch}
            </pre>

                <div class="flex-1">
                    <div
                        class="mb-4 border-b border-border pb-2 font-semibold text-primary"
                    >
                        joelf@dev
                    </div>
                    <dl class="grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2">
                        {
                            info.map((item) => (
                                <div class="flex gap-3">
                                    <dt class="w-28 shrink-0 text-primary">
                                        {item.label}
                                    </dt>
                                    <dt class="text-muted-foreground">
                                        {item.value}
                                    </dt>
                                </div>
                            ))
                        }
                    </dl>

                    <div class="mt-5 flex gap-2">
                        <span class="h-4 w-6 rounded-sm bg-secondary"></span>
                        <span class="h-4 w-6 rounded-sm bg-muted-foreground/40"
                        ></span>
                        <span class="h-4 w-6 rounded-sm bg-primary/60"></span>
                        <span class="h-4 w-6 rounded-sm bg-primary"></span>
                        <span class="h-4 w-6 rounded-sm bg-foreground/80"
                        ></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
