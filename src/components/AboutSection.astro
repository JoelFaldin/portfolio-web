---
import { timeline } from "./contants/constants";
import SectionLabel from "./SectionLabel.astro";
---

<section id="about" class="border-t border-border/60 py-24">
    <div class="container mx-auto px-4">
        <SectionLabel
            section="cat about.md"
            title="From interfaces to infrastructure"
        />

        <div class="mt-14 grid gap-10 lg:grid-cols-[1fr_2fr]">
            <div class="flex flex-col justify-between">
                <p
                    class="text-pretty text-lg leading-relaxed text-muted-foreground"
                >
                    I enjoy working across the stack: shaping <span
                        class="font-bold text-foreground">web experiences</span
                    > people can use, then stepping underneath them to <span
                        class="font-bold text-foreground">understand</span
                    > the services, protocols and primitives that make them work.
                    I like moving between the visible product and the systems underneath
                    it, <span class="font-bold text-foreground"
                        >without losing sight of either side</span
                    >.
                </p>

                <span
                    class="border-t border-border pt-4 text-muted-foreground text-sm tracking-widest"
                >
                    <span class="text-primary">SCOPE</span> / WEB · BACKEND · SYSTEMS
                </span>
            </div>

            <ol class="relative space-y-8 border-l border-border pl-6">
                {
                    timeline.map((item) => (
                        <li class="relative">
                            <span class="absolute -left-7 top-1.5 h-2.5 w-2.5 rounded-full border border-primary bg-background" />
                            <div class="mb-1 font-mono text-xs uppercase tracking-widest text-primary">
                                {item.period}
                            </div>
                            <h3 class="mb-1.5 font-mono text-lg font-semibold text-foreground">
                                {item.title}
                            </h3>
                            <p class="text-pretty leading-relaxed text-muted-foreground">
                                {item.body}
                            </p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </div>
</section>
