---
import SectionLabel from "./SectionLabel.astro";

const timeline = [
    {
        period: "one side",
        title: "web development",
        body: "I build full stack applications using modern technologies. Focused on clean interfaces and scalable backends.",
    },
    {
        period: "the connection",
        title: "Internal workings",
        body: "The web keeps leading me toward deeper questions - how requests travel, how concurrency behaves, and what a database does under pressure. Systems work gives those questions a practical home.",
    },
    {
        period: "alongside",
        title: "Systems programming",
        body: "In my free time I explore the fundamentals of networking and systems using Go. These projects make the services and products I build more deliberate, not separate from them.",
    },
];
---

<section id="about" class="border-t border-border/60 py-24">
    <div class="container mx-auto px-4">
        <SectionLabel
            section="cat about.md"
            title="From interfaces to infrastructure"
        />

        <div class="mt-14 grid gap-10 lg:grid-cols-[1fr_1.4fr]">
            <p
                class="text-pretty text-lg leading-relaxed text-muted-foreground"
            >
                I enjoy working across the stack: shaping web experiences people
                can use, then stepping underneath them to understand the
                services, protocols and primitives that make them work.
            </p>

            <ol class="relative space-y-8 border-l border-border pl-6">
                {
                    timeline.map((item) => (
                        <li class="relative">
                            <span class="absolute -left-7 top-1.5 h-2.5 w-2.5 rounded-full border border-primary bg-background" />
                            <div class="mb-1 font-mono text-xs uppercase tracking-widest text-primary">
                                {item.period}
                            </div>
                            <h3 class="mb-1.5 font-mono text-lg font-semibold text-foreground">
                                {item.title}
                            </h3>
                            <p class="text-pretty leading-relaxed text-muted-foreground">
                                {item.body}
                            </p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </div>
</section>
