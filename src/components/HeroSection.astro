---
import { capabilities } from "./contants/constants";
import ArrowDown from "./icons/ArrowDown.astro";
import Email from "./icons/Email.astro";
import Github from "./icons/Github.astro";
import Terminal from "./Terminal.svelte";
---

<section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 grid-bg" aria-hidden></div>

    <div class="container mx-auto relative px-4 pb-20 pt-10 md:pb-40 md:pt-30">
        <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
            <div>
                <p
                    class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 font-mono text-xs text-muted-foreground"
                >
                    Software Engineer
                </p>

                <h1
                    class="text-balance font-mono text-4xl font-bold leading-tight tracking-tight text-foreground sm:text-5xl"
                >
                    <span>Joel </span>
                    <span aria-hidden="true">
                        Fald<span class="i-wrap text-primary">
                            <span class="i-stem">í</span>
                            <span class="i-accent">í</span>
                        </span>n
                    </span>
                </h1>

                <p
                    class="mt-6 max-w-xl text-pretty text-lg leading-relaxed text-muted-foreground"
                >
                    Working across interfaces, services and networks that
                    connects them. I use <span class="font-bold text-foreground"
                        >TypeScript</span
                    > to shape web experiences and explore how requests, protocols
                    and systems keep them moving.
                </p>

                <div class="mt-8 flex flex-wrap gap-3">
                    <a
                        href="#projects"
                        class="inline-flex items-center gap-2 rounded-md bg-primary px-5 py-2.5 font-mono text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
                    >
                        view projects
                        <ArrowDown classProp="h-4 w-4" />
                    </a>
                    <a
                        href="#contact"
                        class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-5 py-2.5 font-mono text-sm text-foreground transition-colors hover:border-primary/50 hover:text-primary"
                    >
                        <Email classProp="h-4 w-4" />
                        get in touch
                    </a>
                    <a
                        href="https://github.com/JoelFaldin"
                        target="_blank"
                        class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-5 py-2.5 font-mono text-sm text-foreground transition-colors hover:border-primary/50 hover:text-primary"
                    >
                        <Github classProp="h-4 w-4" />
                        github
                    </a>
                </div>

                <div
                    class="mt-12 grid max-w-xl gap-3 border-t border-border/70 pt-5 grid-cols-1 sm:grid-cols-3"
                >
                    {
                        capabilities.map((cap) => (
                            <div class="my-2">
                                <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-primary">
                                    {cap.label}
                                </div>
                                <p class="font-mono text-xs leading-relaxed text-muted-foreground">
                                    {cap.values}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <Terminal client:visible />
        </div>
    </div>
</section>

<style>
    .i-wrap {
        position: relative;
        display: inline-block;
    }

    .i-stem,
    .i-accent {
        display: inline-block;
    }

    .i-stem {
        clip-path: inset(36% 0 0 0);
    }

    .i-accent {
        position: absolute;
        inset: 0;
        clip-path: inset(0 0 64% 0);
        animation: accent-drop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        animation-delay: 0.6s;
    }

    @keyframes accent-drop {
        0% {
            opacity: 0;
            transform: translateY(8px);
            color: var(--color-primary);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
            color: inherit;
        }
    }
</style>
