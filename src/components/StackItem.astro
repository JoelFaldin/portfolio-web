---
const { index, label, title, desc, techs } = Astro.props;
---

<section
    class="group min-h-80 flex flex-col bg-card transition-colors hover:bg-secondary/50 p-8"
>
    <div class="flex flex-row items-start justify-between">
        <slot />
        <span class="text-muted-foreground">0{index}</span>
    </div>

    <div class="mt-12">
        <p class="text-primary text-xs">{label.toUpperCase()}</p>
        <h4 class="mt-2 text-foreground text-xl font-mono">{title}</h4>
        <p class="mt-3 text-sm text-muted-foreground">{desc}</p>
    </div>

    <div class="mt-auto flex flex-wrap gap-2 pt-8">
        {
            techs.map((tech: string) => (
                <span class="rounded-md border border-border bg-background text-muted-foreground px-2.5 py-1 font-mono  text-xs transition-colors">
                    {tech}
                </span>
            ))
        }
    </div>
</section>
